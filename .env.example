# Plantilla segura para documentar variables.
# Este archivo si puede subirse al repositorio/servidor.
# No pongas aqui tokens reales; crea/configura .env o variables del sistema en el servidor.

# En servidor, cambiar por una ruta persistente con permisos de escritura.
MODEL_STORAGE_DIR=models/runtime

# Reportes temporales por lote. Limpiar periodicamente.
REPORTS_DIR=reports/runtime

MAX_UPLOAD_MB=2
MAX_BATCH_ROWS=100

# Dejar vacio en la plantilla. En servidor generar un token real y secreto.
FEEDBACK_TOKEN=

PORT=5000
WEB_CONCURRENCY=1
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=120
LOG_LEVEL=info

TF_NUM_INTRAOP_THREADS=1
TF_NUM_INTEROP_THREADS=1
OMP_NUM_THREADS=1
